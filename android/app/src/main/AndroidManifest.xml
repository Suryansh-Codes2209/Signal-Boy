<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- ConnectivityManager.getActiveNetwork(), used to read a raw connected
         boolean without relying on WifiInfo.getNetworkId() (see WifiBridge). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android classifies WiFi identity as location data. Needed for SSID and
         BSSID, and for scan results up to API 32. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- API 33+ can scan without a location grant, provided the app declares it
         is not deriving location from the results. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <uses-feature android:name="android.hardware.wifi" android:required="true" />

    <!-- Pre-31: normal permissions, granted at install, needed to use the
         Bluetooth APIs at all. Capped with maxSdkVersion because API 31+
         replaces both with the runtime permissions below. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- API 31+: scanning under neverForLocation, since this app never derives
         location from BLE results (see the Bluetooth hunting amendment). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Needed to read a device's cached name via BluetoothDevice.getName()
         when the advertisement itself carries none. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Not required: a device with no Bluetooth radio still gets a working
         WiFi meter, it just cannot open the HUNT tab. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- RANGE (Android 16+): true distance to a peer whose radio answers, via
         RangingManager. Unlike every other reading in HUNT this is measured,
         not inferred from RSSI, which is exactly why it needs its own grant.
         Declared unconditionally because the platform ignores an unknown
         permission below API 36; RangeBridge gates the request itself. -->
    <uses-permission android:name="android.permission.RANGING" />

    <!-- CELL: read-only cellular telemetry (serving/neighbour cells, band,
         RSRP/RSRQ). READ_PHONE_STATE plus the location grant above are what
         TelephonyManager.getAllCellInfo() needs to return cell identity. No
         transmit capability is requested or possible; the modem is read only. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- LINK (active test only): the app is otherwise fully offline. This is
         requested solely for the opt-in throughput/latency test in the LINK tab,
         which does nothing until the user accepts its consent gate. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Signal Boy"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:supportsRtl="false"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
