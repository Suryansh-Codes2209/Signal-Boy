<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Splash theme, active only for the brief window before installSplashScreen()
      hands the activity back to its normal theme (postSplashScreenTheme).
      Same LCD-green background as the launcher icon's adaptive-icon layer and
      the same foreground art, so launcher -> splash -> app reads as one panel
      staying lit rather than three different screens.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lcd_3</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AppCompat.NoActionBar</item>
    </style>
</resources>
